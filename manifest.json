{
    "manifest_version": 3,
    "name": "1.도서 목록 매칭 매니저",
    "version": "1.37.0",
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "permissions": [
        "contextMenus",
        "storage",
        "identity",
        "unlimitedStorage",
        "activeTab",
        "scripting",
        "downloads",
        "alarms",
        "cookies",
        "sidePanel"
    ],
    "host_permissions": [
        "https://transfer.it/*",
        "https://*.api.mega.co.nz/*",
        "https://*.userstorage.mega.co.nz/*",
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "author.json",
                "images/caret-down-solid-full.svg",
                "images/sliders-solid-full.svg",
                "images/arrow-up-wide-short-solid-full.svg",
                "images/arrow-up-short-wide-solid-full.svg"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "options.html",
        "default_icon": {
            "16": "icon.png",
            "32": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "side_panel": {
        "default_path": "options.html#sidepanel"
    },
    "options_page": "options.html",
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "common.js",
                "vendor/motion.js",
                "vendor/anime.umd.min.js",
                "library-motion.js",
                "category-ui.js",
                "book-ui.js",
                "book-shortcuts.js",
                "content.js"
            ],
            "css": [
                "book-ui.css",
                "category-ui.css"
            ],
            "run_at": "document_end"
        }
    ]
}
